# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# The 4K master of the hero video is far too large for Git (GitHub rejects files over 100 MB)
# and for the web. The site uses the compressed copies in public/hero/ instead.
/21spheres-explainer-4K60-new-audio.mp4
/public/21spheres-explainer-4K60-new-audio.mp4
